map API.createPrepaymentRequest(string requestBody)
{
	// API calls this function from the CRM widget.
	res = Map();
	reqData = Map();
	creatorPayload = Map();
	creatorResponse = Map();
	creatorResult = Map();
	stage = "start";
	try 
	{
		stage = "toMap";
		if(requestBody == null || requestBody.trim() == "")
		{
			res.put("success",false);
			res.put("message","requestBody is empty");
			res.put("stage",stage);
			return res;
		}
		reqData = requestBody.toMap();
		stage = "required fields";
		requiredFields = {"mfsp_reference","booking_name","supplier_reference","supplier_name","service_id","service_date","requested_by","requested_date","transaction_type","total_proforma_amount","payments","proforma_file_name","proforma_file_base64"};
		for each  fieldName in requiredFields
		{
			if(ifnull(reqData.get(fieldName),"").toString().trim() == "")
			{
				res.put("success",false);
				res.put("message",fieldName + " is required");
				res.put("stage",stage);
				return res;
			}
		}
		stage = "payload";
		creatorPayload.put("mfsp_reference",reqData.get("mfsp_reference"));
		creatorPayload.put("booking_name",reqData.get("booking_name"));
		creatorPayload.put("supplier_reference",reqData.get("supplier_reference"));
		creatorPayload.put("supplier_name",reqData.get("supplier_name"));
		creatorPayload.put("service_id",reqData.get("service_id"));
		creatorPayload.put("service_name",ifnull(reqData.get("service_name"),""));
		creatorPayload.put("service_date",reqData.get("service_date"));
		creatorPayload.put("requested_by",reqData.get("requested_by"));
		creatorPayload.put("requested_date",reqData.get("requested_date"));
		creatorPayload.put("observations",ifnull(reqData.get("observations"),""));
		creatorPayload.put("transaction_type",reqData.get("transaction_type"));
		creatorPayload.put("total_proforma_amount",reqData.get("total_proforma_amount").toString().toDecimal());
		payments = reqData.get("payments");
		if(payments == null || payments.size() < 1)
		{
			res.put("success",false);
			res.put("message","At least one payment is required");
			res.put("stage",stage);
			return res;
		}
		creatorPayload.put("payments",payments);
		creatorPayload.put("proforma_file_name",reqData.get("proforma_file_name"));
		creatorPayload.put("proforma_file_base64",reqData.get("proforma_file_base64"));
		stage = "creator custom api";
		headers = Map();
		headers.put("Content-Type","application/json");
		creatorResponse = invokeurl
		[
			url :"https://www.zohoapis.eu/creator/custom/madeforspainandportugal/Create_Prepayment_Request"
			type :POST
			parameters:creatorPayload.toString()
			headers:headers
			connection:"creator_oauth"
		];
		stage = "build response";
		if(ifnull(creatorResponse.get("code"),0).toLong() != 3000)
		{
			res.put("success",false);
			res.put("message",ifnull(creatorResponse.get("message"),"Creator endpoint returned an error."));
			res.put("result",creatorResponse);
			res.put("stage",stage);
			return res;
		}
		creatorResult = ifnull(creatorResponse.get("result"),"{}").toString().toMap();
		res.put("success",ifnull(creatorResult.get("success"),false));
		res.put("result",creatorResult);
		res.put("stage",stage);
		if(!ifnull(creatorResult.get("success"),false))
		{
			res.put("message",ifnull(creatorResult.get("message"),"Creator could not create the pre-payment request."));
		}
	}	catch (e)
	{
		res.put("success",false);
		res.put("message",e.toString());
		res.put("stage",stage);
	}
	return res;
}
// Creator custom function.
// Publish as a POST Custom API named Create_RENFE_Payment.
map API.createRenfePayment(string requestBody)
{
	result = Map();
	try
	{
		if(requestBody == null || requestBody.trim() == "")
		{
			result.put("success",false);
			result.put("message","requestBody is required.");
			return result;
		}

		data = requestBody.toMap();
		requiredFields = {"service_id","requested_date","requested_by","mfsp_reference","booking_name","localizador_ticket_renfe","total_tickets_amount"};
		for each fieldName in requiredFields
		{
			if(ifnull(data.get(fieldName),"").toString().trim() == "")
			{
				result.put("success",false);
				result.put("message",fieldName + " is required.");
				return result;
			}
		}

		amount = data.get("total_tickets_amount").toString().toDecimal();
		if(amount <= 0)
		{
			result.put("success",false);
			result.put("message","Total Tickets Amount must be greater than zero.");
			return result;
		}

		renfePaymentId = insert into RENFE_Payments_Form
		[
			Service_ID = data.get("service_id")
			Requested_Date = data.get("requested_date").toString().toDate("yyyy-MM-dd")
			Requested_By = data.get("requested_by")
			MFSP_Reference = data.get("mfsp_reference")
			Booking_Name = data.get("booking_name")
			Localizador_Ticket_RENFE = data.get("localizador_ticket_renfe")
			Total_Tickets_Amount = amount
			Observations = ifnull(data.get("observations"),"")
		];

		result.put("success",true);
		result.put("renfe_payment_id",renfePaymentId.toString());
	}
	catch (e)
	{
		result.put("success",false);
		result.put("message",e.toString());
	}
	return result;
}

Validate_data_Proforma_Fo as "Validate data - Proforma Form"
{
	type =  form
	form = Proforma_Form

	record event = on add or edit

	on validate
	{
		actions 
		{
			custom deluge script
			(
					paymentsSize = 0;
				currentHour = zoho.currenttime.getHour();
				amount = 0;
				// 0–23
				for each  p in input.Payments
				{
					paymentsSize = paymentsSize + 1;
					// 1) On a specific date pero sin fecha
					if(p.Payment_Date == null)
					{
						alert "Payment Date is missing. Please add date on Payment Date field to continue.";
						cancel submit;
					}
					if(zoho.loginuserid != "r.bautista@madeforspainandportugal.com" && zoho.loginuserid != "andersson@madeforspainandportugal.com" && zoho.loginuserid != "claudia@madeforspainandportugal.com" && zoho.loginuserid != "luciano@madeforspainandportugal.com" && zoho.loginuserid != "gabi@madeforspainandportugal.com")
					{
						// 2) Fecha hoy pero después de las 14:00
						if(p.Payment_Date == zoho.currentdate && currentHour >= 14)
						{
							alert "A payment is scheduled for today, but submissions after 14:00 are not allowed. Please select a future payment date to continue.";
							cancel submit;
						}
					}
					amount = amount + p.Amount;
				}
				if(amount < input.Total_Proforma_Amount)
				{
					alert "The sum of all payments is not equals to Total Proforma Amount. Please fix it to continue.";
					cancel submit;
				}
			)
		}
	}

}


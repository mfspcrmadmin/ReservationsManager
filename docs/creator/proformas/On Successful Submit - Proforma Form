On_Successful_Submit_Prof as "On Successful Submit - Proforma Form"
{
	type =  form
	form = Proforma_Form

	record event = on add

	on success
	{
		actions 
		{
			custom deluge script
			(
					if(!isnull(input.Service_ID))
				{
					bsCRMMap = Map();
					bsCRMMap.put("Status_EZUS","Pre-Payment Requested");
					optionalMap = Map();
					bsCRMUpdateRes = zoho.crm.updateRecord("Booking_Services",input.Service_ID.toLong(),bsCRMMap,optionalMap,"crm_oauth");
				}
				openUrl("#Page:Form_Correctly_Submitted","same window");
				thisapp.Email.send_acc_PrepaymentNotification(input.ID);
			)
		}
	}

}


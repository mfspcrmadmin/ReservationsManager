// Publish as a POST Custom API named Create_Card_Purchase.
map API.createCardPurchase(string requestBody)
{
	result = Map();
	try
	{
		if(requestBody == null || requestBody.trim() == "")
		{
			result.put("success",false);
			result.put("message","requestBody is required.");
			return result;
		}
		data = requestBody.toMap();
		requiredFields = {"mfsp_reference","booking_name","service_id","supplier_code","supplier_name","service_name","service_date","amount","status","requested_by"};
		for each fieldName in requiredFields
		{
			if(ifnull(data.get(fieldName),"").toString().trim() == "")
			{
				result.put("success",false);
				result.put("message",fieldName + " is required.");
				return result;
			}
		}
		amount = data.get("amount").toString().toDecimal();
		if(amount <= 0)
		{
			result.put("success",false);
			result.put("message","Amount must be greater than zero.");
			return result;
		}

		cardPurchaseId = insert into Card_Purchase
		[
			MFSP_Reference = data.get("mfsp_reference")
			Booking_Name = data.get("booking_name")
			Service_Id = data.get("service_id")
			Supplier_Code = data.get("supplier_code")
			Supplier_Name = data.get("supplier_name")
			Service_Name = data.get("service_name")
			Service_Date = data.get("service_date").toString().toDate("yyyy-MM-dd")
			Amount = amount
			Status = data.get("status")
			Observations = ifnull(data.get("observations"),"")
			Requested_By = data.get("requested_by")
		];
		result.put("success",true);
		result.put("card_purchase_id",cardPurchaseId.toString());
	}
	catch (e)
	{
		result.put("success",false);
		result.put("message",e.toString());
	}
	return result;
}

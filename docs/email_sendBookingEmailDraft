string standalone.email_sendBookingEmailDraftAndDelete(String bookingId,String draftId,String actingUserEmail)
{
res = Map();
res.put("error",false);
bookingId = ifnull(bookingId,"").toString().trim();
draftId = ifnull(draftId,"").toString().trim();
actingUserEmail = ifnull(actingUserEmail,"").toString().trim();
if(bookingId == "")
{
	res.put("error",true);
	res.put("message","bookingId is empty.");
	return res;
}
if(draftId == "")
{
	res.put("error",true);
	res.put("message","draftId is empty.");
	return res;
}
if(actingUserEmail == "")
{
	res.put("error",true);
	res.put("message","actingUserEmail is empty.");
	return res;
}
getDraftUrl = "https://www.zohoapis.eu/crm/v8/Deals/" + bookingId + "/__email_drafts/" + draftId;
draftResp = invokeurl
[
	url :getDraftUrl
	type :GET
	connection:"crm_oauth_connection"
];
if(isnull(draftResp))
{
	res.put("error",true);
	res.put("message","Empty response while fetching the draft.");
	return res;
}
if(draftResp.containKey("code") && draftResp.get("code") != null)
{
	res.put("error",true);
	res.put("message","Zoho API returned an error while fetching the draft.");
	res.put("api_response",draftResp);
	return res;
}
draftItems = ifnull(draftResp.get("__email_drafts"),List());
if(draftItems.isEmpty())
{
	res.put("error",true);
	res.put("message","The requested draft was not found.");
	res.put("api_response",draftResp);
	return res;
}
draftData = draftItems.get(0);
toItems = draftData.get("to");
if(isnull(toItems) || toItems.isEmpty())
{
	res.put("error",true);
	res.put("message","The draft does not contain any recipients in the to field.");
	res.put("draft_data",draftData);
	return res;
}
toEmailList = List();
for each  toItem in toItems
{
	toEmail = ifnull(toItem.get("email"),"").toString().trim();
	if(toEmail != "")
	{
		toEmailList.add(toEmail);
	}
}
if(toEmailList.isEmpty())
{
	res.put("error",true);
	res.put("message","The draft does not contain valid recipient emails in the to field.");
	res.put("draft_data",draftData);
	return res;
}
ccItems = draftData.get("cc");
ccEmailList = List();
seenCcEmails = Map();
if(!isnull(ccItems) && !ccItems.isEmpty())
{
	for each  ccItem in ccItems
	{
		ccEmail = ifnull(ccItem.get("email"),"").toString().trim();
		if(ccEmail != "")
		{
			normalizedCcEmail = ccEmail.toLowerCase();
			if(!seenCcEmails.containKey(normalizedCcEmail))
			{
				ccEmailList.add(ccEmail);
				seenCcEmails.put(normalizedCcEmail,true);
			}
		}
	}
}
normalizedActingUserEmail = actingUserEmail.toLowerCase();
if(!seenCcEmails.containKey(normalizedActingUserEmail))
{
	ccEmailList.add(actingUserEmail);
	seenCcEmails.put(normalizedActingUserEmail,true);
}
subjectText = ifnull(draftData.get("subject"),"").toString();
messageText = ifnull(draftData.get("content"),"").toString();
toText = "";
for each  toEmailValue in toEmailList
{
	if(toText != "")
	{
		toText = toText + ",";
	}
	toText = toText + toEmailValue;
}
ccText = "";
for each  ccEmailValue in ccEmailList
{
	if(ccText != "")
	{
		ccText = ccText + ",";
	}
	ccText = ccText + ccEmailValue;
}
sendmail
[
	from :zoho.loginuserid
	to :toText
	cc :ccText
	reply to :actingUserEmail
	subject :subjectText
	message :messageText
]
deleteUrl = "https://www.zohoapis.eu/crm/v8/Deals/" + bookingId + "/__email_drafts/" + draftId;
deleteResp = invokeurl
[
	url :deleteUrl
	type :DELETE
	connection:"crm_oauth_connection"
];
res.put("message","Draft sent successfully.");
res.put("delete_response",deleteResp);
if(isnull(deleteResp))
{
	res.put("warning","The email was sent, but the delete response was empty.");
	return res;
}
if(deleteResp.containKey("code") && deleteResp.get("code") != null)
{
	res.put("warning","The email was sent, but the draft could not be deleted automatically.");
	return res;
}
return res;
}
